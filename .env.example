# Database — pick ONE path:
# (A) Production: ENV=production fetches DB_USER+DB_PASSWORD from AWS Secrets Manager
ENV=production
DB_SECRET_ARN=
DB_HOST=
DB_NAME=
AWS_REGION=
# (B) Local dev: ENV=local (default), set DB_USER + DB_PASSWORD directly
# ENV=local
# DB_USER=
# DB_PASSWORD=

# Put your key in ONE of these (see README — run scripts/verify_gemini_connection.py to pick GEMINI_CLIENT)
VERTEX_AI_API_KEY=
# GEMINI_API_KEY=
# vertex_express (default) or google_ai_studio
GEMINI_CLIENT=vertex_express
GEMINI_MODEL=gemini-2.5-flash

# Logging — DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
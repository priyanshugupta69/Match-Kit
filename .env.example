# Database — pick ONE path:
# (A) Production: credentials fetched from AWS Secrets Manager via boto3
DB_SECRET_ARN=arn:aws:secretsmanager:eu-north-1:375268683259:secret:rds!db-1e83c140-295e-4fc6-9358-19a90bd40e5d-Ja3sWy
DB_HOST=rds.eu-north-1.amazonaws.com
DB_NAME=postgres
AWS_REGION=eu-north-1
# (B) Local dev: set DB_USER + DB_PASSWORD directly (leave DB_SECRET_ARN empty)
# DB_USER=
# DB_PASSWORD=

# Put your key in ONE of these (see README — run scripts/verify_gemini_connection.py to pick GEMINI_CLIENT)
VERTEX_AI_API_KEY=
# GEMINI_API_KEY=
# vertex_express (default) or google_ai_studio
GEMINI_CLIENT=vertex_express
GEMINI_MODEL=gemini-2.5-flash

# Logging — DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
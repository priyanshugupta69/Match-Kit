# Database — GCP Cloud SQL Postgres over private VPC IP in prod, localhost in dev.
ENV=production
DB_HOST=          # Cloud SQL private IP (e.g. 10.x.x.x) reachable from the app's VPC
DB_PORT=5432
DB_NAME=postgres
DB_USER=
DB_PASSWORD=

# Put your key in ONE of these (see README — run scripts/verify_gemini_connection.py to pick GEMINI_CLIENT)
VERTEX_AI_API_KEY=
# GEMINI_API_KEY=
# vertex_express (default) or google_ai_studio
GEMINI_CLIENT=vertex_express
GEMINI_MODEL=gemini-2.5-flash

# Logging — DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
